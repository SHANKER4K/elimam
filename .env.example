# Hugging Face access token, used by cli/cli.py and the notebooks.
# Read-only is enough unless you are pushing datasets. https://huggingface.co/settings/tokens
HF_TOKEN=""

# Provider API key for the model endpoint in web.py and temp/*.py
# (OpenCode/Zen dashboard).
PROVIDER_API_KEY=""
