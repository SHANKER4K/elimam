QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
DATABASE_HOST=localhost
DATABASE_USER=
DATABASE_NAME=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_SSLMODE=disable   # local docker Postgres; prod stays "require"
BOT_SHARED_SECRET=          # must match telegram service
USER_SHARED_SECRET=         # HMAC secret for Next.js proxy X-User-* headers
ENCRYPTION_MASTER_KEY=      # Fernet key for api/keys.py encrypt/decrypt
TELEGRAM_BOT_TOKEN=
FRONTEND_ORIGIN=            # empty = no direct browser CORS (desired: Next proxy only)
AUTH_MODE=permissive        # "permissive" (rollout aid) or "enforce"
EMBEDDING_URL=http://embedding:80
RERANKER_URL=http://reranker:80
# Jev (TypeSafe System One) reranker. Leave JEV_API_KEY empty and the
# cross-encoder above keeps doing the work.
# Console key: https://opencode.ai/console/account#api-keys
# jev-1.13-free is free for a limited time and can disappear without notice;
# the backend falls back to the cross-encoder when it does.
JEV_API_URL=https://opencode.ai/inference/systemone/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13-free
JEV_POOL=24             # candidates sent to Jev; max(top_k, this), bounded by rerank_pool
JEV_RERANK=on            # "off" = cross-encoder only, for comparing the two
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LOG_LEVEL=INFO

