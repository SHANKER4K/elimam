    {
      "type": "text",
      "id": "t1",
      "x": 20,
      "y": 15,
      "width": 510,
      "height": 30,
      "text": "1. System Architecture & Entrypoints",
      "originalText": "1. System Architecture & Entrypoints",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 3,
      "version": 1,
      "versionNonce": 3,
      "isDeleted": false,
