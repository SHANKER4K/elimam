      "width": 510,
      "height": 30,
      "text": "2. Agent Workflow & Execution",
      "originalText": "2. Agent Workflow & Execution",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
