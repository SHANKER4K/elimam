    {
      "type": "text",
      "id": "sideeffects_text",
      "x": 510,
      "y": 530,
      "width": 380,
      "height": 100,
      "text": "Import‑time side effects (need stack):\n- db/connection.py builds psycopg2 pool at import\n- search.py loads models + connects to Qdrant at import\n- api/chat.py calls setup_indexes() and reads skill.md at import\n- api/providers.py lazily loads providers table on first use",
      "originalText": "Import‑time side effects (need stack):\n- db/connection.py builds psycopg2 pool at import\n- search.py loads models + connects to Qdrant at import\n- api/chat.py calls setup_indexes() and reads skill.md at import\n- api/providers.py lazily loads providers table on first use",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
